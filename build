#!/bin/sh
set -eu

project_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$project_dir"
host_port=${HOST_PORT:-7001}

if ! command -v docker >/dev/null 2>&1; then
    echo "Docker is required. Install and start Docker Desktop, then run ./build again." >&2
    exit 1
fi

if ! docker compose version >/dev/null 2>&1; then
    echo "Docker Compose is required. Install Docker Compose, then run ./build again." >&2
    exit 1
fi

docker compose up --build -d
echo "Marketplace API is running at http://localhost:${host_port}"
